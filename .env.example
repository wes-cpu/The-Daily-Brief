GMAIL_FROM=wesseifert1995@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here
EMAIL_TO=wes@seifert.farm

# Scoular CBLOC — cookie-based auth (no MFA on every run)
# Run get_scoular_cookies.py locally once to capture these.
SCOULAR_COOKIES=

# Scoular fallback credentials (used only if SCOULAR_COOKIES is empty)
SCOULAR_USER=
SCOULAR_PASS=

# Auto-rotation of SCOULAR_COOKIES (keeps session alive forever — no manual refresh needed)
# Create a GitHub Fine-Grained PAT with "Secrets" read+write on this repo only.
# See: github.com → Settings → Developer settings → Personal access tokens → Fine-grained
GH_PAT=your_fine_grained_pat_here
